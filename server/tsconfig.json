{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true,
    "types": [
      "node",
      "express-session",
      "passport"
    ],
    "declaration": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts"
  ]
}
