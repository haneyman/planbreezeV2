{
  "name": "planbreeze",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "npm run build:api && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "tsc -p server --noEmit && nuxt typecheck",
    "test": "npm run build:api && vitest run",
    "postinstall": "nuxt prepare",
    "dev:api": "npm run build:api && node --watch --env-file-if-exists=.env server/dist/server/src/main.js",
    "build:api": "tsc -p server",
    "start:api": "node --env-file-if-exists=.env server/dist/server/src/main.js",
    "import:convex": "node --env-file-if-exists=.env server/scripts/import-convex.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nuxt/ui": "^4.11.2",
    "@vueuse/core": "^15.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.15",
    "mongoose": "^9.11.4",
    "nuxt": "^4.5.2",
    "openai": "^7.49.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-strategy": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.4",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-strategy": "^0.2.38",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
