# Copy to .env. Secrets are used by the API only.
NUXT_PUBLIC_API_URL=http://localhost:3001/api
SITE_URL=http://localhost:3000
API_URL=http://localhost:3001/api
HOST=127.0.0.1
PORT=3001
# Local standalone Docker MongoDB. Production uses authenticated MongoDB on the droplet; see docs/10-migration-and-deployment.md.
MONGODB_URI=mongodb://127.0.0.1:27017/planbreeze
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Generate with: openssl rand -base64 32. Keep the existing key when importing calendar tokens.
TOKEN_ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
# PEM key; literal \n escapes are supported. Apple requires an HTTPS callback.
AUTH_APPLE_PRIVATE_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set false to disable all background workers/scheduled work.
JOBS_ENABLED=true
# Outbound email is opt-in.
EMAIL_ENABLED=false
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=US
EMAIL_FROM=
EMAIL_REPLY_TO=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=in.planbreeze.com
