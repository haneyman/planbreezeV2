# Front end (Nuxt). `npx convex dev` writes CONVEX_DEPLOYMENT and CONVEX_URL to .env.local;
# copy the URL here as NUXT_PUBLIC_CONVEX_URL.
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Everything below is set in Convex, not here:
#   npx convex env set <NAME> <value>
# SITE_URL=http://localhost:3000            (https://planbreeze.com in production)
# JWT_PRIVATE_KEY / JWKS                    (npx @convex-dev/auth sets these)
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET       (Google sign-in)
# AUTH_APPLE_ID / AUTH_APPLE_SECRET         (Sign in with Apple)
# GOOGLE_CALENDAR_CLIENT_ID / _SECRET       (optional; defaults to the AUTH_GOOGLE_* client)
# TOKEN_ENCRYPTION_KEY                      (openssl rand -base64 32)
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL        (Breeze)
# RESEND_API_KEY, EMAIL_FROM                (invite emails; optional)
# INBOUND_EMAIL_SECRET, INBOUND_EMAIL_DOMAIN (email forwarding; optional)
